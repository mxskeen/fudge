---
import Base from '../layouts/Base.astro';
import Demo from '../components/Demo.astro';
import Counter from '../components/Counter.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const GH = 'https://github.com/mxskeen/fudge';
---
<Base title="Fudge: press Alt Space, type, done">
  <section class="hero">
    <img class="hero-icon" src={`${base}/icon-256.png`} width="136" height="136" alt="Fudge" data-reveal />
    <p class="eyebrow" data-reveal>Pre-alpha. Linux and macOS.</p>
    <h1 data-reveal>Press Alt Space.<br />Type. Done.</h1>
    <p class="sub" data-reveal>Fudge is a keyboard launcher that answers on your machine and never phones home.</p>
    <p class="actions" data-reveal>
      <a class="btn" href={GH}>View on GitHub</a>
      <a class="more" href={`${base}/install/`}>Build from source</a>
    </p>
  </section>

  <section class="stage" aria-label="Live demo">
    <Demo />
  </section>

  <section class="band" aria-labelledby="answers-h">
    <h2 id="answers-h" data-reveal>Answers, not search results.</h2>
    <p class="sub" data-reveal>Maths, units, currency, time zones, emoji and colours, resolved as you type.</p>
    <p class="mono" data-reveal>12 * 18 &nbsp; 72 f to c &nbsp; 12 usd to inr<br />time tokyo &nbsp; emoji shrug &nbsp; #3b82f6</p>
  </section>

  <section class="band alt" aria-labelledby="box-h">
    <h2 id="box-h" data-reveal>Everything on your machine, one box.</h2>
    <p class="sub" data-reveal>Open apps and files. Switch windows. End a process. Lock the screen.</p>
    <p class="mono" data-reveal>firefox &nbsp; budget 2026 &nbsp; win code<br />kill spotify &nbsp; kill port 3000 &nbsp; lock</p>
  </section>

  <section class="band" aria-labelledby="private-h">
    <h2 id="private-h" data-reveal>Private by design.</h2>
    <div data-reveal><Counter /></div>
    <p class="sub" data-reveal>Fudge makes one network request: a currency rate lookup, at most once an hour, which you can turn off.</p>
    <p class="actions" data-reveal><a class="more" href={`${base}/privacy/`}>Read the privacy details</a></p>
  </section>

  <section class="band alt" aria-labelledby="desktop-h">
    <h2 id="desktop-h" data-reveal>Made for the desktop you use.</h2>
    <p class="sub" data-reveal>A native Rust and GTK4 app that stays resident, so the hotkey only has to show it.</p>
    <dl class="status" data-reveal>
      <div><dt>Linux, X11</dt><dd>Global hotkey works today.</dd></div>
      <div><dt>Linux, Wayland</dt><dd>Planned. No global hotkey yet; bind <code>fudge toggle</code> to a key.</dd></div>
      <div><dt>macOS</dt><dd>Planned. Untested.</dd></div>
    </dl>
    <p class="actions" data-reveal><a class="more" href={`${base}/roadmap/`}>See the roadmap</a></p>
  </section>

  <section class="band" aria-labelledby="free-h">
    <h2 id="free-h" data-reveal>Free. Open source.<br />Forever.</h2>
    <p class="sub" data-reveal>MIT or Apache-2.0, your choice. No account, no telemetry, no licence key.</p>
    <p class="actions" data-reveal><a class="more" href={GH}>Read the source on GitHub</a></p>
  </section>
</Base>
