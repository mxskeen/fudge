---
import Logo from '../components/Logo.astro';
import '../styles/global.css';
interface Props { title: string; description?: string }
const { title, description = 'Fudge is a free, open-source keyboard launcher for Linux and macOS. Press Alt+Space, type, get the answer. Pre-alpha.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const nav = [
  ['/install/', 'Install'], ['/plugins/', 'Plugins'], ['/roadmap/', 'Roadmap'],
  ['/privacy/', 'Privacy'], ['/contribute/', 'Contribute'], ['/changelog/', 'Changelog'],
];
const GH = 'https://github.com/fudge-launcher/fudge';
const isCur = (p: string) => path.replace(base, '') === p;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbf3e6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c120c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={`${base}/`}><Logo size={30} /><span>fudge</span></a>
        <nav aria-label="Main">
          <ul>
            {nav.map(([href, label]) => (
              <li><a href={`${base}${href}`} aria-current={isCur(href) ? 'page' : undefined}>{label}</a></li>
            ))}
            <li><a class="gh" href={GH}>GitHub</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap foot">
        <div>
          <a class="brand" href={`${base}/`}><Logo size={26} /><span>fudge</span></a>
          <p>Free and open source under MIT or Apache-2.0, your choice. Pre-alpha software.</p>
        </div>
        <ul>
          <li><a href={GH}>Source on GitHub</a></li>
          <li><a href={`${base}/install/`}>Install</a></li>
          <li><a href={`${base}/privacy/`}>Privacy</a></li>
          <li><a href={`${base}/roadmap/`}>Roadmap</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
