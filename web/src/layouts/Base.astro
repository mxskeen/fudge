---
import Logo from '../components/Logo.astro';
import '../styles/global.css';
interface Props { title: string; description?: string }
const { title, description = 'Fudge is a free, open-source keyboard launcher for Linux and macOS. Press Alt Space, type, get the answer. Pre-alpha.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const GH = 'https://github.com/mxskeen/fudge';
const nav = [['/install/', 'Install'], ['/plugins/', 'Plugins'], ['/roadmap/', 'Roadmap'], ['/privacy/', 'Privacy']];
const isCur = (p: string) => path.replace(base, '') === p;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${base}/favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="icon" href={`${base}/favicon-16.png`} type="image/png" sizes="16x16" />
    <link rel="shortcut icon" href={`${base}/favicon.ico`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(`${base}/og.png`, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <div class="nav-in">
        <a class="brand" href={`${base}/`} aria-label="Fudge, home"><Logo /></a>
        <nav aria-label="Main">
          <ul>
            {nav.map(([href, label]) => (
              <li><a href={`${base}${href}`} aria-current={isCur(href) ? 'page' : undefined}>{label}</a></li>
            ))}
            <li><a href={GH}>GitHub</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="foot">
      <div class="foot-in">
        <div class="foot-cols">
          <div>
            <h2>Fudge</h2>
            <ul>
              <li><a href={`${base}/install/`}>Install</a></li>
              <li><a href={`${base}/plugins/`}>Plugins</a></li>
              <li><a href={`${base}/roadmap/`}>Roadmap</a></li>
              <li><a href={`${base}/changelog/`}>Changelog</a></li>
            </ul>
          </div>
          <div>
            <h2>Project</h2>
            <ul>
              <li><a href={GH}>GitHub</a></li>
              <li><a href={`${base}/contribute/`}>Contribute</a></li>
              <li><a href={`${base}/privacy/`}>Privacy</a></li>
            </ul>
          </div>
        </div>
        <p>Fudge is free software under MIT or Apache-2.0. Pre-alpha.</p>
      </div>
    </footer>
    <script>
      const els = document.querySelectorAll('[data-reveal]');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
        els.forEach((e) => e.classList.add('in'));
      } else {
        const io = new IntersectionObserver((es) => {
          for (const e of es) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach((e) => io.observe(e));
      }
    </script>
  </body>
</html>
