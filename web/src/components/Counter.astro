<div class="counter" aria-live="polite">
  <strong id="net-count">0</strong>
  <span>network requests made by this page to other websites</span>
</div>
<p class="small" id="net-detail">Counting live in your browser with the Performance API: every resource this page loaded, minus the ones from its own origin.</p>
<script>
  const out = document.getElementById('net-count')!;
  const detail = document.getElementById('net-detail')!;
  const seen = new Set<string>();
  let own = 0;
  function scan(entries: PerformanceEntryList) {
    for (const e of entries) {
      let origin = '';
      try { origin = new URL(e.name, location.href).origin; } catch { continue; }
      if (origin === location.origin) { own++; continue; }
      if (origin === 'null' || origin.startsWith('data:') || origin.startsWith('blob:')) continue;
      seen.add(e.name);
    }
    out.textContent = String(seen.size);
    detail.textContent = `Counting live in your browser with the Performance API. This page has loaded ${own} file${own === 1 ? '' : 's'} from its own server (including the demo's WebAssembly) and ${seen.size} from anywhere else.`;
  }
  scan(performance.getEntriesByType('resource'));
  try {
    new PerformanceObserver((l) => scan(l.getEntries())).observe({ type: 'resource', buffered: false });
  } catch { /* older browsers: the one-off scan above still ran */ }
  // The observer only sees new entries, so recount everything once things settle.
  window.addEventListener('load', () => { own = 0; seen.clear(); setTimeout(() => scan(performance.getEntriesByType('resource')), 800); });
</script>
