---
// Logo slot: small app icon plus the text wordmark. Swap the image or the
// wordmark here; the .brand link wrapper lives in layouts/Base.astro.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<img class="mark" src={`${base}/icon-48.png`} width="22" height="22" alt="" /><span class="wordmark">fudge</span>
