---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tries = ['12 * 18', '72 f to c', '12 usd to inr', 'time tokyo', '#3b82f6', 'kill spotify'];
---
<div class="demo-wrap">
  <div class="demo" id="demo" data-wasm={`${base}/wasm/fudge_compute.js`}>
    <div class="demo-input">
      <input id="demo-q" type="text" role="combobox" aria-expanded="true" aria-controls="demo-list" aria-autocomplete="list" aria-activedescendant="" aria-label="Fudge demo: type a query" placeholder="Search apps, files, math…" autocomplete="off" autocapitalize="off" spellcheck="false" />
    </div>
    <ul id="demo-list" class="demo-list" role="listbox" aria-label="Results"></ul>
    <div class="demo-foot">
      <span id="demo-hint">↑↓ move · Enter run · Ctrl+Enter alt · Esc clear</span>
      <span id="demo-engine">Starting the answers engine</span>
    </div>
  </div>
  <p class="demo-tries" aria-label="Example queries">
    {tries.map((q) => <button type="button" data-q={q}>{q}</button>)}
  </p>
  <p class="demo-note">
    This is a live demo. Math, units, time, emoji and colours are answered by the real engine,
    compiled to WebAssembly. Currency uses fixed sample rates. Apps, files, windows and shell
    rows come from a fake list, and nothing is launched.
  </p>
</div>

<script>
  type Answer = { kind: string; title: string; subtitle: string; copy_text: string; color_hex: string | null };
  type Row = { id: string; title: string; sub: string; tag: string; color?: string; copy?: string; sim?: string };

  const root = document.getElementById('demo')!;
  const input = document.getElementById('demo-q') as HTMLInputElement;
  const list = document.getElementById('demo-list')!;
  const hint = document.getElementById('demo-hint')!;
  const engineEl = document.getElementById('demo-engine')!;
  const HINT = hint.innerHTML;

  // Sample rates against USD. Fixed and made up for the demo, not live.
  const SAMPLE_RATES = JSON.stringify({ USD: 1, EUR: 0.92, GBP: 0.79, INR: 83.1, JPY: 151.0, CAD: 1.36, AUD: 1.52, CHF: 0.88, CNY: 7.2, BRL: 5.0 });

  const APPS = ['Firefox', 'Files', 'Spotify', 'Visual Studio Code', 'Terminal', 'Settings', 'Calculator', 'LibreOffice Calc', 'GIMP', 'Thunderbird', 'Obsidian'];
  const FILES = ['budget-2026.ods', 'budget-notes.md', 'budapest-trip.pdf', 'resume-2026.pdf', 'recipes/fudge-brownies.md', 'invoice-0042.pdf', 'photos/beach.jpg'];
  const WINDOWS = ['Firefox: Fudge Launcher', 'Code: main.rs', 'Terminal: ~/code', 'Spotify: Lofi Beats'];
  const PROCS = ['Spotify', 'Firefox', 'Slack', 'Discord'];
  const SEARCH: Record<string, string> = { yt: 'YouTube', gh: 'GitHub', online: 'the web', g: 'the web', so: 'Stack Overflow', w: 'Wikipedia' };
  const SYSTEM = ['lock', 'sleep', 'restart', 'shutdown', 'logout'];
  const TAG: Record<string, string> = { math: 'Math', unit: 'Unit', currency: 'Currency', time: 'Time', emoji: 'Emoji', color: 'Colour' };

  let evalJson: ((q: string, now: number, rates: string) => string) | null = null;
  let rows: Row[] = [];
  let sel = 0;
  let toastTimer = 0;

  function fuzzy(q: string, s: string): boolean {
    const a = q.toLowerCase(), b = s.toLowerCase();
    if (b.includes(a)) return true;
    let i = 0;
    for (const ch of b) if (ch === a[i]) i++;
    return i === a.length && a.length >= 2;
  }
  const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

  function compute(q: string): Row[] {
    if (!evalJson) return [];
    try {
      const out = JSON.parse(evalJson(q, Date.now(), SAMPLE_RATES)) as Answer[];
      return out.slice(0, 3).map((a, i) => ({
        id: `c${i}`,
        title: a.title,
        sub: a.kind === 'currency' ? a.subtitle.replace(/rates from the internet/, 'sample rates, not live') : a.subtitle,
        tag: TAG[a.kind] ?? a.kind,
        color: a.color_hex ?? undefined,
        copy: a.copy_text,
      }));
    } catch { return []; }
  }

  function simulated(q: string): Row[] {
    const out: Row[] = [];
    const sim = (what: string) => `Simulated: ${what}. Nothing happens in this demo.`;
    let m: RegExpMatchArray | null;
    if (q.startsWith('>')) {
      const cmd = q.slice(1).trim();
      if (cmd) out.push({ id: 'sh', title: `Run: ${cmd}`, sub: 'Shell command, audit-logged', tag: 'Shell', sim: sim(`the real app would run "${cmd}" in your shell`) });
      return out;
    }
    if ((m = q.match(/^\/(\w+)\s+(.+)$/)) && SEARCH[m[1].toLowerCase()]) {
      const where = SEARCH[m[1].toLowerCase()];
      out.push({ id: 'ws', title: `Search ${where} for "${m[2]}"`, sub: 'Opens your browser. Never automatic.', tag: 'Web', sim: sim(`the real app would open your browser at ${where}`) });
      return out;
    }
    if ((m = q.match(/^kill\s+port\s+(\d{2,5})$/i))) {
      out.push({ id: 'kp', title: `End whatever listens on :${m[1]}`, sub: 'Asks before ending protected processes', tag: 'Kill', sim: sim(`the real app would end the process listening on port ${m[1]}`) });
      return out;
    }
    if ((m = q.match(/^kill\s+(.+)$/i))) {
      for (const p of PROCS.filter((p) => fuzzy(m![1].trim(), p)).slice(0, 3))
        out.push({ id: `k${p}`, title: `End ${p} and its helpers`, sub: 'Process (fake list)', tag: 'Kill', sim: sim(`the real app would end ${p}`) });
      return out;
    }
    if ((m = q.match(/^win(?:dow)?\s+(.+)$/i))) {
      for (const w of WINDOWS.filter((w) => fuzzy(m![1].trim(), w)).slice(0, 3))
        out.push({ id: `w${w}`, title: w, sub: 'Bring window forward (fake list)', tag: 'Window', sim: sim(`the real app would raise "${w}"`) });
      return out;
    }
    const lq = q.toLowerCase();
    for (const s of SYSTEM.filter((s) => s.startsWith(lq) && lq.length >= 2))
      out.push({ id: `s${s}`, title: cap(s), sub: s === 'lock' ? 'Lock the screen' : 'Asks first, it cannot be undone', tag: 'System', sim: sim(`the real app would ${s} your computer`) });
    if (lq.length >= 2 && !/[\d=+*/^%()]/.test(lq)) {
      for (const n of APPS.filter((n) => fuzzy(lq, n)).slice(0, 4))
        out.push({ id: `a${n}`, title: n, sub: 'Application (fake list)', tag: 'App', sim: sim(`the real app would launch ${n}`) });
      for (const f of FILES.filter((f) => fuzzy(lq, f)).slice(0, 3))
        out.push({ id: `f${f}`, title: f.split('/').pop()!, sub: `~/${f} (fake list)`, tag: 'File', sim: sim(`the real app would open ${f}`) });
    }
    return out;
  }

  function recents(): Row[] {
    return [
      { id: 'r1', title: 'Firefox', sub: 'Application (fake list)', tag: 'App', sim: 'Simulated: the real app would launch Firefox.' },
      { id: 'r2', title: 'budget-2026.ods', sub: '~/budget-2026.ods (fake list)', tag: 'File', sim: 'Simulated: the real app would open the file.' },
      { id: 'r3', title: 'Spotify', sub: 'Application (fake list)', tag: 'App', sim: 'Simulated: the real app would launch Spotify.' },
    ];
  }

  const G = (d: string) => `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
  const ICON: Record<string, string> = {
    Math: G('<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8M8 12h.01M12 12h.01M16 12h.01M8 16h.01M12 16h.01M16 16h.01"/>'),
    Unit: G('<path d="M7 7h13l-3-3M17 17H4l3 3"/>'),
    Currency: G('<path d="M12 3v18M16 7.5c-1-1-2.4-1.5-4-1.5-2.2 0-4 1-4 2.8s1.6 2.4 4 3.2 4 1.4 4 3.2-1.8 2.8-4 2.8c-1.6 0-3-.5-4-1.5"/>'),
    Time: G('<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>'),
    App: G('<rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/>'),
    File: G('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/>'),
    Kill: G('<circle cx="12" cy="12" r="9"/><path d="m9 9 6 6M15 9l-6 6"/>'),
    Window: G('<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 9h18"/>'),
    System: G('<path d="M12 3v9"/><path d="M6.3 6.8a8 8 0 1 0 11.4 0"/>'),
    Web: G('<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/>'),
    Shell: G('<path d="m5 8 4 4-4 4M12 16h7"/>'),
  };
  const ACTION: Record<string, string> = { Math: 'Copy', Unit: 'Copy', Currency: 'Copy', Time: 'Copy', Emoji: 'Copy', Colour: 'Copy', App: 'Launch', File: 'Open', Kill: 'Kill', Window: 'Focus', System: 'Run', Web: 'Open', Shell: 'Run' };

  function render() {
    list.textContent = '';
    const q = input.value.trim();
    if (!q) {
      const h = document.createElement('li');
      h.className = 'demo-empty'; h.setAttribute('role', 'presentation');
      h.textContent = 'Recent';
      list.append(h);
    }
    if (q && !rows.length) {
      const h = document.createElement('li');
      h.className = 'demo-empty'; h.setAttribute('role', 'presentation');
      h.textContent = `No results for "${q}" in this demo.`;
      list.append(h);
    }
    rows.forEach((r, i) => {
      const li = document.createElement('li');
      li.id = `demo-opt-${r.id}`;
      li.className = 'demo-row';
      li.setAttribute('role', 'option');
      li.setAttribute('aria-selected', String(i === sel));
      const ic = document.createElement('span'); ic.className = 'ic'; ic.setAttribute('aria-hidden', 'true');
      if (r.color) ic.style.background = r.color;
      else if (r.tag === 'Emoji') { ic.classList.add('em'); ic.textContent = r.title; }
      else ic.innerHTML = ICON[r.tag] ?? ICON.App;
      li.append(ic);
      const tx = document.createElement('span'); tx.className = 'tx';
      const t = document.createElement('span'); t.className = r.tag === 'Math' ? 't big' : 't'; t.textContent = r.title;
      const s = document.createElement('span'); s.className = 's'; s.textContent = r.sub;
      tx.append(t, s);
      const k = document.createElement('span'); k.className = 'k'; k.textContent = `↵ ${ACTION[r.tag] ?? 'Run'}`;
      li.append(tx, k);
      li.addEventListener('mousemove', () => { if (sel !== i) { sel = i; mark(); } });
      li.addEventListener('click', () => { sel = i; mark(); run(); input.focus(); });
      list.append(li);
    });
    mark();
  }

  function mark() {
    [...list.querySelectorAll('[role=option]')].forEach((el, i) => el.setAttribute('aria-selected', String(i === sel)));
    input.setAttribute('aria-activedescendant', rows[sel] ? `demo-opt-${rows[sel].id}` : '');
    const cur = list.querySelector('[aria-selected=true]') as HTMLElement | null;
    if (cur) {
      // Scroll only the list. scrollIntoView would also scroll the page.
      if (cur.offsetTop < list.scrollTop) list.scrollTop = cur.offsetTop - 6;
      else if (cur.offsetTop + cur.offsetHeight > list.scrollTop + list.clientHeight) list.scrollTop = cur.offsetTop + cur.offsetHeight - list.clientHeight + 6;
    }
  }

  function update() {
    const q = input.value.trim();
    rows = q ? [...compute(q), ...simulated(q)] : recents();
    sel = 0;
    render();
  }

  function toast(msg: string) {
    hint.innerHTML = '';
    const s = document.createElement('span'); s.className = 'demo-toast'; s.textContent = msg;
    s.setAttribute('role', 'status');
    hint.append(s);
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => (hint.innerHTML = HINT), 3500);
  }

  async function run() {
    const r = rows[sel];
    if (!r) return;
    if (r.copy !== undefined) {
      try { await navigator.clipboard.writeText(r.copy); toast(`Copied "${r.copy}" to your clipboard.`); }
      catch { toast(`In the real app this copies "${r.copy}".`); }
    } else toast(r.sim ?? 'Simulated.');
  }

  input.addEventListener('input', update);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); if (rows.length) { sel = (sel + 1) % rows.length; mark(); } }
    else if (e.key === 'ArrowUp') { e.preventDefault(); if (rows.length) { sel = (sel - 1 + rows.length) % rows.length; mark(); } }
    else if (e.key === 'Enter') { e.preventDefault(); run(); }
    else if (e.key === 'Escape') { input.value = ''; update(); }
  });

  function focusDemo() {
    input.focus();
    root.scrollIntoView({ block: 'center', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  }
  window.addEventListener('keydown', (e) => {
    if ((e.altKey && e.code === 'Space') || ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k')) { e.preventDefault(); focusDemo(); }
  });
  root.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('li')) input.focus(); });
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('[data-q]') as HTMLElement | null;
    if (!b) return;
    input.value = b.dataset.q ?? '';
    update();
    input.focus({ preventScroll: true });
    root.scrollIntoView({ block: 'center', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  });

  // Gentle first-view typing. Stops on any key, click or touch.
  const SAMPLE = '12 * 18';
  let typingTimer = 0, typed = false;
  function stopTyping() { clearTimeout(typingTimer); typed = true; }
  ['keydown', 'pointerdown', 'touchstart'].forEach((ev) => window.addEventListener(ev, stopTyping, { passive: true }));
  input.addEventListener('focus', () => { if (input.value === SAMPLE.slice(0, input.value.length) && input.value) input.select(); });
  function typeSample(i = 0) {
    if (typed || input.value && i === 0) return;
    input.value = SAMPLE.slice(0, i);
    update();
    if (i < SAMPLE.length) typingTimer = window.setTimeout(() => typeSample(i + 1), 170);
  }
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { io.disconnect(); typingTimer = window.setTimeout(() => typeSample(), 700); }
    }, { threshold: 0.6 });
    io.observe(root);
  }

  update();

  async function loadEngine() {
    try {
      const url = root.dataset.wasm!;
      const mod = await import(/* @vite-ignore */ url);
      await mod.default({ module_or_path: url.replace(/fudge_compute\.js$/, 'fudge_compute_bg.wasm') });
      evalJson = mod.evaluate_json;
      engineEl.textContent = 'Answers by fudge-compute, running in WebAssembly';
      if (input.value.trim()) update();
    } catch {
      engineEl.textContent = 'Answers engine failed to load';
    }
  }
  loadEngine();
</script>
