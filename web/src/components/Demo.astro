---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="demo-wrap">
  <div class="demo" id="demo" data-wasm={`${base}/wasm/fudge_compute.js`}>
    <div class="demo-input">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
      <input id="demo-q" type="text" role="combobox" aria-expanded="true" aria-controls="demo-list" aria-autocomplete="list" aria-activedescendant="" aria-label="Fudge demo: type a query" placeholder="Type, e.g. 12 * 18" autocomplete="off" autocapitalize="off" spellcheck="false" />
    </div>
    <ul id="demo-list" class="demo-list" role="listbox" aria-label="Results"></ul>
    <div class="demo-foot">
      <span id="demo-hint"><kbd>↑</kbd> <kbd>↓</kbd> move · <kbd>Enter</kbd> run · <kbd>Esc</kbd> clear</span>
      <span id="demo-engine">Starting the answers engine…</span>
    </div>
  </div>
  <p class="small demo-note">
    Press <kbd>Alt</kbd>+<kbd>Space</kbd> or <kbd>Ctrl</kbd>+<kbd>K</kbd> to focus the box.
    <strong>What is real:</strong> math, units, time, emoji and colours are answered by the actual
    <code>fudge-compute</code> Rust crate compiled to WebAssembly. Currency uses fixed <em>sample rates</em>
    (no network). Apps, files, windows, kill, web search and shell rows are <strong>simulated in the browser</strong>
    from a fake list; nothing is launched or run.
  </p>
</div>

<script>
  type Answer = { kind: string; title: string; subtitle: string; copy_text: string; color_hex: string | null };
  type Row = { id: string; icon: string; title: string; sub: string; tag: string; color?: string; copy?: string; sim?: string };

  const root = document.getElementById('demo')!;
  const input = document.getElementById('demo-q') as HTMLInputElement;
  const list = document.getElementById('demo-list')!;
  const hint = document.getElementById('demo-hint')!;
  const engineEl = document.getElementById('demo-engine')!;
  const HINT = hint.innerHTML;

  // Sample rates against USD. Fixed and made up for the demo, not live.
  const SAMPLE_RATES = JSON.stringify({ USD: 1, EUR: 0.92, GBP: 0.79, INR: 83.1, JPY: 151.0, CAD: 1.36, AUD: 1.52, CHF: 0.88, CNY: 7.2, BRL: 5.0 });

  const APPS: [string, string][] = [
    ['Firefox', '🦊'], ['Files', '📁'], ['Spotify', '🎵'], ['Visual Studio Code', '🧑‍💻'], ['Terminal', '⬛'],
    ['Settings', '⚙️'], ['Calculator', '🧮'], ['LibreOffice Calc', '📊'], ['GIMP', '🎨'], ['Thunderbird', '✉️'], ['Obsidian', '🗒️'],
  ];
  const FILES = ['budget-2026.ods', 'budget-notes.md', 'budapest-trip.pdf', 'resume-2026.pdf', 'recipes/fudge-brownies.md', 'invoice-0042.pdf', 'photos/beach.jpg'];
  const WINDOWS = ['Firefox: Fudge Launcher', 'Code: main.rs', 'Terminal: ~/code', 'Spotify: Lofi Beats'];
  const PROCS = ['Spotify', 'Firefox', 'Slack', 'Discord'];
  const SEARCH: Record<string, string> = { yt: 'YouTube', gh: 'GitHub', online: 'the web', g: 'the web', so: 'Stack Overflow', w: 'Wikipedia' };
  const SYSTEM = ['lock', 'sleep', 'restart', 'shutdown', 'logout'];
  const ICON: Record<string, string> = { math: '=', unit: '⇄', currency: '💱', time: '🕒', emoji: '😀', color: '🎨' };
  const TAG: Record<string, string> = { math: 'Math', unit: 'Unit', currency: 'Currency', time: 'Time', emoji: 'Emoji', color: 'Colour' };

  let evalJson: ((q: string, now: number, rates: string) => string) | null = null;
  let rows: Row[] = [];
  let sel = 0;
  let toastTimer = 0;

  function fuzzy(q: string, s: string): boolean {
    const a = q.toLowerCase(), b = s.toLowerCase();
    if (b.includes(a)) return true;
    let i = 0;
    for (const ch of b) if (ch === a[i]) i++;
    return i === a.length && a.length >= 2;
  }
  const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

  function compute(q: string): Row[] {
    if (!evalJson) return [];
    try {
      const out = JSON.parse(evalJson(q, Date.now(), SAMPLE_RATES)) as Answer[];
      return out.slice(0, 3).map((a, i) => ({
        id: `c${i}`,
        icon: ICON[a.kind] ?? '•',
        title: a.title,
        sub: a.kind === 'currency' ? a.subtitle.replace(/rates from the internet/, 'sample rates, not live') : a.subtitle,
        tag: TAG[a.kind] ?? a.kind,
        color: a.color_hex ?? undefined,
        copy: a.copy_text,
      }));
    } catch { return []; }
  }

  function simulated(q: string): Row[] {
    const out: Row[] = [];
    const sim = (what: string) => `Simulated: ${what}. Nothing happens in this demo.`;
    let m: RegExpMatchArray | null;
    if (q.startsWith('>')) {
      const cmd = q.slice(1).trim();
      if (cmd) out.push({ id: 'sh', icon: '>', title: `Run: ${cmd}`, sub: 'Shell command, audit-logged', tag: 'Shell', sim: sim(`the real app would run "${cmd}" in your shell`) });
      return out;
    }
    if ((m = q.match(/^\/(\w+)\s+(.+)$/)) && SEARCH[m[1].toLowerCase()]) {
      const where = SEARCH[m[1].toLowerCase()];
      out.push({ id: 'ws', icon: '🔎', title: `Search ${where} for "${m[2]}"`, sub: 'Opens your browser. Never automatic.', tag: 'Web', sim: sim(`the real app would open your browser at ${where}`) });
      return out;
    }
    if ((m = q.match(/^kill\s+port\s+(\d{2,5})$/i))) {
      out.push({ id: 'kp', icon: '☠️', title: `End whatever listens on :${m[1]}`, sub: 'Asks before ending protected processes', tag: 'Kill', sim: sim(`the real app would end the process listening on port ${m[1]}`) });
      return out;
    }
    if ((m = q.match(/^kill\s+(.+)$/i))) {
      for (const p of PROCS.filter((p) => fuzzy(m![1].trim(), p)).slice(0, 3))
        out.push({ id: `k${p}`, icon: '☠️', title: `End ${p} and its helpers`, sub: 'Process (fake list)', tag: 'Kill', sim: sim(`the real app would end ${p}`) });
      return out;
    }
    if ((m = q.match(/^win(?:dow)?\s+(.+)$/i))) {
      for (const w of WINDOWS.filter((w) => fuzzy(m![1].trim(), w)).slice(0, 3))
        out.push({ id: `w${w}`, icon: '🪟', title: w, sub: 'Bring window forward (fake list)', tag: 'Window', sim: sim(`the real app would raise "${w}"`) });
      return out;
    }
    const lq = q.toLowerCase();
    for (const s of SYSTEM.filter((s) => s.startsWith(lq) && lq.length >= 2))
      out.push({ id: `s${s}`, icon: '⏻', title: cap(s), sub: s === 'lock' ? 'Lock the screen' : 'Asks first, it cannot be undone', tag: 'System', sim: sim(`the real app would ${s} your computer`) });
    if (lq.length >= 2 && !/[\d=+*/^%()]/.test(lq)) {
      for (const [n, ic] of APPS.filter(([n]) => fuzzy(lq, n)).slice(0, 4))
        out.push({ id: `a${n}`, icon: ic, title: n, sub: 'Application (fake list)', tag: 'App', sim: sim(`the real app would launch ${n}`) });
      for (const f of FILES.filter((f) => fuzzy(lq, f)).slice(0, 3))
        out.push({ id: `f${f}`, icon: '📄', title: f.split('/').pop()!, sub: `~/${f} (fake list)`, tag: 'File', sim: sim(`the real app would open ${f}`) });
    }
    return out;
  }

  function recents(): Row[] {
    return [
      { id: 'r1', icon: '🦊', title: 'Firefox', sub: 'Application (fake list)', tag: 'App', sim: 'Simulated: the real app would launch Firefox.' },
      { id: 'r2', icon: '📄', title: 'budget-2026.ods', sub: '~/budget-2026.ods (fake list)', tag: 'File', sim: 'Simulated: the real app would open the file.' },
      { id: 'r3', icon: '🎵', title: 'Spotify', sub: 'Application (fake list)', tag: 'App', sim: 'Simulated: the real app would launch Spotify.' },
    ];
  }

  function render() {
    list.textContent = '';
    const q = input.value.trim();
    if (!q) {
      const h = document.createElement('li');
      h.className = 'demo-empty'; h.setAttribute('role', 'presentation');
      h.textContent = 'Recent (simulated). Type something, or pick an example below.';
      list.append(h);
    }
    if (q && !rows.length) {
      const h = document.createElement('li');
      h.className = 'demo-empty'; h.setAttribute('role', 'presentation');
      h.textContent = `No results for "${q}" in this demo.`;
      list.append(h);
    }
    rows.forEach((r, i) => {
      const li = document.createElement('li');
      li.id = `demo-opt-${r.id}`;
      li.className = 'demo-row';
      li.setAttribute('role', 'option');
      li.setAttribute('aria-selected', String(i === sel));
      if (r.color) { const sw = document.createElement('span'); sw.className = 'sw'; sw.style.background = r.color; sw.setAttribute('aria-hidden', 'true'); li.append(sw); }
      else { const ic = document.createElement('span'); ic.className = 'ic'; ic.textContent = r.icon; ic.setAttribute('aria-hidden', 'true'); li.append(ic); }
      const tx = document.createElement('span'); tx.className = 'tx';
      const t = document.createElement('span'); t.className = 't'; t.textContent = r.title;
      const s = document.createElement('span'); s.className = 's'; s.textContent = r.sub;
      tx.append(t, s);
      const k = document.createElement('span'); k.className = 'k'; k.textContent = r.tag;
      li.append(tx, k);
      li.addEventListener('mousemove', () => { if (sel !== i) { sel = i; mark(); } });
      li.addEventListener('click', () => { sel = i; mark(); run(); input.focus(); });
      list.append(li);
    });
    mark();
  }

  function mark() {
    [...list.querySelectorAll('[role=option]')].forEach((el, i) => el.setAttribute('aria-selected', String(i === sel)));
    input.setAttribute('aria-activedescendant', rows[sel] ? `demo-opt-${rows[sel].id}` : '');
    list.querySelector('[aria-selected=true]')?.scrollIntoView({ block: 'nearest' });
  }

  function update() {
    const q = input.value.trim();
    rows = q ? [...compute(q), ...simulated(q)] : recents();
    sel = 0;
    render();
  }

  function toast(msg: string) {
    hint.innerHTML = '';
    const s = document.createElement('span'); s.className = 'demo-toast'; s.textContent = msg;
    s.setAttribute('role', 'status');
    hint.append(s);
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => (hint.innerHTML = HINT), 3500);
  }

  async function run() {
    const r = rows[sel];
    if (!r) return;
    if (r.copy !== undefined) {
      try { await navigator.clipboard.writeText(r.copy); toast(`Copied "${r.copy}" to your clipboard.`); }
      catch { toast(`In the real app this copies "${r.copy}".`); }
    } else toast(r.sim ?? 'Simulated.');
  }

  input.addEventListener('input', update);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); if (rows.length) { sel = (sel + 1) % rows.length; mark(); } }
    else if (e.key === 'ArrowUp') { e.preventDefault(); if (rows.length) { sel = (sel - 1 + rows.length) % rows.length; mark(); } }
    else if (e.key === 'Enter') { e.preventDefault(); run(); }
    else if (e.key === 'Escape') { input.value = ''; update(); }
  });

  function focusDemo() {
    input.focus();
    root.scrollIntoView({ block: 'center', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  }
  window.addEventListener('keydown', (e) => {
    if ((e.altKey && e.code === 'Space') || ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k')) { e.preventDefault(); focusDemo(); }
  });
  root.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('li')) input.focus(); });
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('[data-q]') as HTMLElement | null;
    if (!b) return;
    input.value = b.dataset.q ?? '';
    update();
    input.focus({ preventScroll: true });
    root.scrollIntoView({ block: 'center', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  });

  update();

  async function loadEngine() {
    try {
      const url = root.dataset.wasm!;
      const mod = await import(/* @vite-ignore */ url);
      await mod.default({ module_or_path: url.replace(/fudge_compute\.js$/, 'fudge_compute_bg.wasm') });
      evalJson = mod.evaluate_json;
      engineEl.textContent = 'Answers: real fudge-compute (WebAssembly) · other rows: simulated';
      if (input.value.trim()) update();
    } catch {
      engineEl.textContent = 'Answers engine failed to load: only simulated rows available';
    }
  }
  loadEngine();
</script>
